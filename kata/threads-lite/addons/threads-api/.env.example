# Public URL used only as metadata. Do not put it in post text unless your strategy needs it.
PUBLIC_SITE_URL=https://example.com

# Meta Threads app settings.
THREADS_CLIENT_ID=your-meta-app-id
THREADS_CLIENT_SECRET=your-meta-app-secret
THREADS_REDIRECT_URI=https://example.com/threads-callback
THREADS_SCOPES=threads_basic,threads_content_publish,threads_manage_insights

# Live publishing secrets. Keep these in .env.local or a secret manager.
THREADS_ACCESS_TOKEN=THAA...
THREADS_USER_ID=1234567890
THREADS_USERNAME=your_threads_username

# Dry run by default.
THREADS_DRY_RUN=True
THREADS_PUBLISH_WAIT_SECONDS=30
THREADS_PUBLISH_RETRIES=3
