<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.threads-automation</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__ABSOLUTE_PROJECT_PATH__/scripts/launchd-runner.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ABSOLUTE_PROJECT_PATH__</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>12</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__ABSOLUTE_PROJECT_PATH__/scripts/.cache/launchd/threads.out.log</string>

  <key>StandardErrorPath</key>
  <string>__ABSOLUTE_PROJECT_PATH__/scripts/.cache/launchd/threads.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
