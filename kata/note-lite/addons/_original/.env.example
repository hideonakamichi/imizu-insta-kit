# note 自動入稿エージェント (note-publisher) 用の環境変数サンプル
# ─────────────────────────────────────────────────────────────────────────
# 使い方:
#   1. このファイルを `.env.local` にコピー
#   2. 自分のキー / 認証情報で値を埋める
#   3. .claude/skills/note-publishing-toolkit/scripts/*.py がパス上から参照します
#      (.env.local はリポジトリ直下に置くこと。スクリプトは scripts から4階層上を見ます)

# ── note.com ログイン認証 ────────────────────────────────────────────────
# 自動入稿先となる note アカウント。捨てアカでなく公式運用アカウントを推奨。
NOTE_EMAIL=your-note-account@example.com
NOTE_PASSWORD=your-note-password

# ── Jina AI ──────────────────────────────────────────────────────────────
# 競合分析 (上位記事の全文取得) + ファクトチェック (公式ソース突合) に使用。
# 取得先: https://jina.ai/api-dashboard/
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Gemini ────────────────────────────────────────────────────────
# サムネイル + 図解画像生成。必ず gemini-3.1-flash-image-preview を使用すること。
# 取得先: https://aistudio.google.com/
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Discord 通知 (任意) ──────────────────────────────────────────────────
# 進捗 / 完了報告を投げる先。未設定なら通知ステップはスキップ。
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...
