# .env.example — Lite 版で使う値（どれも任意。空のままで動きます）
#
# 使い方: cp .env.example .env.local して、使うものだけ埋める。
# ★.env.local は人に見せない・上げない（.gitignore 済み）★
# 元のキットの値（Supabase・サイトの設定など）は addons/site-db/.env.example にあります。

# 完了通知を Discord に送る（空なら通知を飛ばす）
DISCORD_WEBHOOK_URL=

# 図解画像を作るときだけ（config/features.json の images を true にしたとき）。addons/README.md を参照
GEMINI_API_KEY=
