# ============================================================================
# .env.example — 環境変数のテンプレート
#
# 使い方:
#   cp .env.example .env.local
#   そのあと .env.local を開いて、上から順に値を埋めてください。
#
# ★このファイルの値はすべて空です。★ 埋めないと動きません。
# ★.env.local は .gitignore 済みです。絶対に commit しないでください。★
#
# Next.js のサイト側も同じ値を読むので、サイトも動かすなら:
#   cp .env.local site/.env.local
# ============================================================================


# ============================================================================
# 【1】Supabase — ★必須★
#   Supabase = データベースとファイル置き場を、ブラウザから使えるサービス。
#             無料枠があります。
# ============================================================================

# 取得先: https://supabase.com でプロジェクトを作る → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# 取得先: 同じ画面の「service_role」キー (★anon キーではありません★)
#   service_role キーは RLS (誰がどのデータを読めるかの設定) を無視できる強力なキーです。
#   ブラウザに出さないこと。commit しないこと。
SUPABASE_SERVICE_ROLE_KEY=

# 取得先: Supabase の Storage で作った public バケットの名前 (推奨: article-images)
#   Storage = 画像などのファイル置き場。図解画像をここに置きます。
NEXT_PUBLIC_STORAGE_BUCKET=

# 取得先: 入力不要 (バケット内のフォルダ名。既定のままで動きます)
#   図解画像 = sections/ 、キャラアイコン = characters/ に置く想定
NEXT_PUBLIC_STORAGE_SECTIONS_DIR=sections
NEXT_PUBLIC_STORAGE_CHARACTERS_DIR=characters


# ============================================================================
# 【2】画像生成 AI — ★図解を出すなら必須★
# ============================================================================

# 取得先: https://aistudio.google.com/apikey の「Create API key」
#   記事 1 本あたり図解 2 枚を生成します。無料枠で試せます。
GEMINI_API_KEY=


# ============================================================================
# 【3】サイトの基本情報 — ★必須★
#   ここを埋めないと、サイトの表示が「（未設定）」だらけになります。
# ============================================================================

# 取得先: 自分で決める。公開する URL。末尾のスラッシュは付けない
#   ローカルで試すだけなら http://localhost:3000 でも動きます
PUBLIC_SITE_URL=

# 取得先: 自分で決める。ブラウザのタブや検索結果に出るサイト名
NEXT_PUBLIC_SITE_NAME=

# 取得先: 自分で決める。ロゴの 1 段目 (小さい前置き)。不要なら空でよい
NEXT_PUBLIC_SITE_NAME_PRE=

# 取得先: 自分で決める。ロゴの 2 段目 (大きい本体)。空なら NEXT_PUBLIC_SITE_NAME を使う
NEXT_PUBLIC_SITE_NAME_MAIN=

# 取得先: 自分で決める。ヘッダーに出る短い説明 (キャッチコピー)
NEXT_PUBLIC_SITE_TAGLINE=

# 取得先: 自分で決める。検索結果に出る説明文 (meta description)
NEXT_PUBLIC_SITE_DESCRIPTION=


# ============================================================================
# 【4】運営者情報 — ★必須★
#   お金や健康を扱うサイト (YMYL) では「誰が運営しているか」の明示が必要です。
#   /about /privacy /disclaimer の 3 ページで使われます。
# ============================================================================

# 取得先: 自分で決める。運営している会社名 (個人なら屋号や空欄)
NEXT_PUBLIC_OPERATOR_ORG=

# 取得先: 自分で決める。運営責任者の氏名
NEXT_PUBLIC_OPERATOR_NAME=

# 取得先: 自分で決める。問い合わせ先メールアドレス
NEXT_PUBLIC_OPERATOR_EMAIL=

# 取得先: 自分で決める。プライバシーポリシー・免責事項の制定日 (例: 2026年1月1日)
NEXT_PUBLIC_POLICY_DATE=


# ============================================================================
# 【5】通知 — 任意 (空のままなら通知しません)
# ============================================================================

# 取得先: Discord サーバーの 設定 → 連携サービス → ウェブフック → 新しいウェブフック → URLをコピー
#   Webhook URL = 知っている人なら誰でもそのチャンネルに投稿できる URL。鍵と同じ扱いにしてください。
DISCORD_WEBHOOK_URL=


# ============================================================================
# 【6】アクセス解析・LINE — 任意 (空のままなら何も出力しません)
# ============================================================================

# 取得先: Google Analytics → 管理 → データストリーム → 測定ID (G- で始まる文字列)
NEXT_PUBLIC_GA_ID=

# 取得先: LINE Official Account Manager → 友だち追加ガイド → 友だち追加 URL
#   空なら、サイトに LINE の導線は一切表示されません
NEXT_PUBLIC_LINE_ADD_URL=


# ============================================================================
# 【7】その他 — 任意 (既定では使いません)
# ============================================================================

# 取得先: https://jina.ai/?sui=apikey
#   一次情報の取得は Claude Code 内蔵の WebFetch / WebSearch を使うため、通常は空で OK
JINA_API_KEY=
