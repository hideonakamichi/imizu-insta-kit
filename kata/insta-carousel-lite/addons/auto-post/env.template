# env.template — このファイルを .env という名前でコピーして、値を自分のものに書き換えます
#
#   cp env.template .env
#
# ・値は自分でブラウザから取得して、自分の手で貼ってください。AI に読ませたり、チャットに貼ったりしないこと
# ・.env は .gitignore で除外済みです。人に渡す zip にも入れないでください
# ・各サービスの画面操作と詰まりどころは docs/SETUP-GUIDE.md にあります
# ・= の前後に空白を入れない。値を引用符で囲まない


# ------------------------------------------------------------------
# Instagram（必須）— 「Instagram業務用ログイン」方式
#   graph.instagram.com を直接使う方式です。Facebook ページとの連携は要りません。
#   （Facebook ページ経由の旧方式で取った ID・トークンでは、このキットは投稿できません）
#   手順: Instagram をプロアカウントにする → Meta for Developers でアプリを作る →
#         「Instagram」製品を追加 →「Instagram業務用ログイン」でアカウントを追加し、トークンを生成
#   詳細と詰まりどころ: docs/SETUP-GUIDE.md の8節
# ------------------------------------------------------------------
# 投稿先アカウントの数値ID（@ハンドルではない）。アプリの Instagram 設定画面に出る値
IG_USER_ID=
# 長期アクセストークン（60日で失効。週次点検が期限の10日前から自動で更新を試みます）
# このトークンのアカウントが config/brand.yaml の account.handle と違うと、投稿は中止されます
IG_ACCESS_TOKEN=
# 通常はこのまま
GRAPH_API_VERSION=v21.0


# ------------------------------------------------------------------
# Cloudflare R2（必須）— 画像・動画の一時公開
#   Instagram の API は「公開URL上にあるメディア」しか受け付けないため、投稿の直前に置いて、投稿後に消します
#   詳細: docs/SETUP-GUIDE.md の7節
# ------------------------------------------------------------------
# トークン発行画面に出るエンドポイントURLの先頭部分
R2_ACCOUNT_ID=
# Account API トークン。権限は「オブジェクト読み取りと書き込み」、適用先はそのバケットのみ、期限は無期限
# （シークレットは発行時に1回しか表示されません）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 作成したバケット名
R2_BUCKET=
# バケットの「パブリック開発URL」。末尾のスラッシュなし（例: https://pub-xxxxxxxx.r2.dev）
R2_PUBLIC_BASE_URL=


# ------------------------------------------------------------------
# Discord（必須）— 成功・失敗の通知
#   無人運用では「止まったことに気づけるか」がすべてです。通知先のチャンネルでウェブフックを作ります
# ------------------------------------------------------------------
DISCORD_WEBHOOK_URL=


# ------------------------------------------------------------------
# Fish Audio（リールを使うときだけ）— ナレーション音声
#   https://fish.audio/ でAPIキーを発行し、声を試聴してIDをコピーします
# ------------------------------------------------------------------
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=


# ------------------------------------------------------------------
# Grok（リールを使うときだけ）— 映像生成
#   キーはここに書きません。Grok CLI を入れて `grok login` でサインインします
#   （SuperGrok か X Premium+ のサブスクが必要）。カルーセルは Pillow で描くので Grok を使いません
# ------------------------------------------------------------------
# grok コマンドが PATH の外にあるときだけ、フルパスを書く
# GROK_BIN=


# ------------------------------------------------------------------
# （レガシー）旧スライド式リール・旧画像生成に戻す場合だけ
#   .claude/skills/reel-production/references/legacy-slide-pipeline.md
# ------------------------------------------------------------------
# OPENAI_API_KEY=
